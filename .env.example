# ============================================================================
#  Sog'lom Hayot — muhit o'zgaruvchilari
#  Bu faylni `.env` (lokal) ga nusxalang va Vercel'da Environment Variables
#  bo'limiga bir xil qiymatlarni kiriting. `.env` git'ga TUSHMAYDI.
# ============================================================================

# --- Telegram bot ---
# @BotFather -> token. MAXFIY saqlang!
TELEGRAM_BOT_TOKEN="123456789:AA...."

# Webhook xavfsizligi uchun maxfiy satr (tasodifiy 32+ belgi, faqat A-Z a-z 0-9 _ -).
# Bu bo'lmasa istalgan odam soxta update yuborib, boshqa foydalanuvchi nomidan
# dori belgilashi mumkin edi — shuning uchun webhook bu kalitsiz ishlamaydi.
TELEGRAM_WEBHOOK_SECRET="tasodifiy-maxfiy-satr"

# /api/cron/tick va /api/telegram/setup ni himoyalaydi (?key=<CRON_SECRET>
# yoki Authorization: Bearer <CRON_SECRET>).
CRON_SECRET="tasodifiy-maxfiy-satr-2"

# Mini App manzili (ixtiyoriy). Berilmasa Vercel production domeni + /app ishlatiladi.
# WEBAPP_URL="https://your-app.vercel.app/app"

# --- Supabase (Postgres) ---
# Supabase -> Project -> Connect -> ORMs -> Prisma.
# DATABASE_URL — Transaction pooler (6543-port). Vercel funksiyalari shu orqali ulanadi.
DATABASE_URL="postgresql://postgres.xxxx:PAROL@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL — Session pooler yoki to'g'ridan-to'g'ri ulanish (5432-port). Faqat migratsiya uchun.
DIRECT_URL="postgresql://postgres.xxxx:PAROL@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Eski MongoDB (faqat bir martalik ko'chirish skripti uchun: npm run migrate:mongo) ---
# MONGODB_URI="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
